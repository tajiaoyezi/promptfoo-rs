{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "promptfoo-rs compatibility fixture manifest",
  "type": "object",
  "required": [
    "id",
    "test_id",
    "matrix_item_ids",
    "priority",
    "provider_mocking",
    "required_env",
    "expected_outputs",
    "normalization_rules",
    "blocks_stable_release"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "test_id": { "type": "string", "pattern": "^TEST-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "matrix_item_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "provider_mocking": { "enum": ["Mock", "Recorded"] },
    "required_env": { "type": "array", "items": { "type": "string" } },
    "expected_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "normalization_rules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "blocks_stable_release": { "type": "boolean" }
  }
}
